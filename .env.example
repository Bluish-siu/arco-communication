PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=arco_communication
DATABASE_URL=postgresql://postgres:your_db_password@127.0.0.1:5432/arco_communication

# Meta / WhatsApp Business API Configuration
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_CONFIG_ID=your_meta_config_id
META_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token
META_GRAPH_API_VERSION=v21.0
META_REDIRECT_URI=http://localhost:5173/auth/meta/callback
ENCRYPTION_KEY=your_encryption_key_32_bytes_length

# Google OAuth 2.0 Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# Shopify Embedded App Configuration
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here
SHOPIFY_SCOPES=read_products,read_orders,read_customers
SHOPIFY_APP_URL=https://arco-communication.vercel.app
SHOPIFY_REDIRECT_URI=https://arco-backend-ecbl.onrender.com/api/integrations/shopify/callback
SHOPIFY_WEBHOOK_BASE_URL=https://arco-backend-ecbl.onrender.com
VITE_SHOPIFY_API_KEY=your_shopify_api_key_here
